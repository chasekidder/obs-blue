# Install-time secrets for the kickstart (NOT written to site.toml).
# Copy to site/install.env. Format: KEY=VALUE, one per line, no quotes, split
# on the first "=". Parsed by the render snippet in iso/README.md (never
# `source`d by a shell, so `$` in the hash is safe).

# SHA-512 crypt hash of the `stream` user's password. Generate with:
#   openssl passwd -6        (or: mkpasswd -m sha-512)
PASSWORD_HASH=

# One-line SSH public key (e.g. contents of ~/.ssh/id_ed25519.pub) that may
# log in as `stream`. Must not contain a double quote.
SSH_PUBKEY=

# Headscale pre-auth key (the tailnet is headscale.chasekidder.com). On the
# Headscale server: headscale preauthkeys create --user <user> --expiration 24h
# Prefer a single-use, non-ephemeral key with a short expiry.
TAILSCALE_AUTHKEY=
