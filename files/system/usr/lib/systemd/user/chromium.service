[Unit]
Description=Chromium for stream-pilot
PartOf=graphical-session.target
After=graphical-session.target xdg-desktop-portal.service

[Service]
ExecStartPre=-/usr/bin/stream-pilot chromium-prep
ExecStart=/usr/libexec/stream-pilot/chromium-launch about:blank
# Always: the host closing Chromium's window (a clean exit) must not leave the PC without it,
# least of all while live. stream-pilot's power-off stops the unit itself.
Restart=always
RestartSec=3
OOMScoreAdjust=500
# Soft ceiling (16 GB PC). Facebook's live dashboard, which is the comments column,
# grows about 2 MB/min (measured 2026-11-24), so 3G would be reached in a long sale.
MemoryHigh=5G

[Install]
WantedBy=graphical-session.target
