# stream-pilot window layout. The geometry below assumes a 1920x1080 screen with
# the default bottom panel, which leaves a 1920x1034 work area: OBS fills the left
# 70% (1344x1034), the Facebook comments popout is the right 30% column (576x1034).
# stream-pilot's config has no override for this.
#
# Installed as an XDG default (/etc/xdg/kwinrulesrc); KWin reads kwinrulesrc through
# KSharedConfig::openConfig, so a user's ~/.config/kwinrulesrc cascades over it.
# Keys verified against KWin 6.8.2 (rulesettings.kcfg): <key>rule = 2 means "Force",
# 3 means "Apply initially" (only when the window opens; the user can change it after);
# wmclassmatch/titlematch 1 = exact, 2 = substring; types=1 is NET::NormalMask (normal
# windows). On Wayland OBS's dialogs (Settings, Properties, Confirm Changes) are normal
# windows too, so the OBS rule also matches the main window's title ("OBS <version>
# - Profile: ..."); otherwise every dialog is forced to the main window's geometry; decorationpolicy=none replaces
# the deprecated noborder key; [General] Order replaces the legacy count/rules keys
# (KWin 6.8 migrates those by rewriting the user's config on first load).
[General]
Order=1,2,3

[1]
Description=stream-pilot: OBS Studio left column
wmclass=com.obsproject.Studio
wmclasscomplete=false
wmclassmatch=1
title=- Profile:
titlematch=2
types=1
position=0,0
positionrule=2
size=1344,1034
sizerule=2
decorationpolicy=none
decorationpolicyrule=2
above=false
aboverule=2

[2]
Description=stream-pilot: Facebook comments popout right column
wmclass=chrome-www.facebook.com__live_producer_dashboard
wmclasscomplete=false
wmclassmatch=2
position=1344,0
positionrule=2
size=576,1034
sizerule=2
decorationpolicy=none
decorationpolicyrule=2
above=true
aboverule=2
skiptaskbar=true
skiptaskbarrule=2
skippager=true
skippagerrule=2
skipswitcher=true
skipswitcherrule=2

# Forced, not "Apply initially": RustDesk un-minimizes itself right after mapping. Its
# connection server runs in this window's process, so the window has to exist. To change
# RustDesk settings, untick this rule in System Settings > Window Rules, then re-tick it.
[3]
Description=stream-pilot: RustDesk starts minimized
wmclass=Rustdesk
wmclasscomplete=false
wmclassmatch=1
types=1
minimize=true
minimizerule=2
